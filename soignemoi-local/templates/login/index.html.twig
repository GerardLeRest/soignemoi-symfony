{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <h2 class="text-center mb-4">Connexion</h2>

    {% if error %}
        <div class="alert alert-danger" role="alert">
            {% if error.messageKey == 'Invalid credentials.' %}
                Adresse email ou mot de passe incorrect.
            {% else %}
                {{ error.messageKey|trans(error.messageData, 'security') }}
            {% endif %}
        </div>
    {% endif %}

    <div class="row justify-content-center">
        <form action="{{ path('app_login') }}" method="post" class="card p-4 col-lg-6 col-md-10 shadow-sm">
            <div class="mb-3">
                <label for="username" class="form-label">Email :</label>
                <input type="text" id="username" name="_username" class="form-control border-3" value="{{ last_username }}" required autofocus>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Mot de passe :</label>
                <input type="password" id="password" name="_password" class="form-control border-3" required>
            </div>

            <div class="text-center">
                <button type="submit" class="btn bouton-perso">
                    <i class="fas fa-sign-in-alt"></i> Connexion
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

