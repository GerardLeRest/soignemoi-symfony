{% extends 'base.html.twig' %}

{% block content %}
    {{ parent() }}
    <div class="container">
        {{ form_start(form, {'method': 'POST'}) }}
        <div class="row">
            
            <!-- Colonne de gauche (2 colonnes) -->
            <div class="col-lg-2">
                <!-- Espace réservé à gauche -->
            </div>
            
            <!-- Colonne centrale avec les champs -->
            <div class="col-lg-8">
                <div class="row  mb-3">
                    <div class="mb-3 col-lg-6 col-md-12">
                        {{ form_label(form.prenom, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.prenom) }}
                    </div>
                    <div class="mb-3 col-lg-6 col-md-12">
                        {{ form_label(form.nom, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>
                </div>
                <div class="mb-3 col-lg-8 col-md-12">
                    {{ form_label(form.adressePostale, 'Adresse Postale', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.adressePostale, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.adressePostale) }}
                </div>
                <div class="mb-3 col-lg-8 col-md-12">
                    {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="mb-3 col-lg-8 col-md-12">
                    {{ form_label(form.password, 'Mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.password) }}
                </div>
                <div class="text-center">
                    <button type="submit" class="btn bouton-perso">Valider</button>
                </div>
            </div>

            <!-- Colonne de droite (2 colonnes) -->
            <div class="col-lg-2">
                <!-- Espace réservé à droite -->
            </div>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}