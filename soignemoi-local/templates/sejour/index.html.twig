{% extends 'base.html.twig' %}

{% block content %}
    {{ parent() }}
    
    {{ form_start(form, {'method': 'POST'}) }}

    <div class="container">
        <div class="row">
            <!-- Colonne de gauche (2 colonnes) -->
            <div class="col-lg-2">
                <!-- Espace réservé à gauche -->
            </div>
            
            <!-- Colonne centrale avec les champs -->
            <div class="col-lg-8">
                <div class="row mb-3">
                    <div class="col-lg-6 col-md-12 mb-3">
                        {{ form_label(form.dateDebut, 'Date de Début', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.dateDebut) }}
                    </div>
                    <div class="col-lg-6 col-md-12 mb-3">
                        {{ form_label(form.dateFin, 'Date de Fin', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.dateFin, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.dateFin) }}
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-lg-12 col-md-12">
                        {{ form_label(form.motifSejour, 'Motif du séjour', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.motifSejour, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.motifSejour) }}
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-lg-6 col-md-12 mb-3">
                        {{ form_label(form.specialite, 'Spécialité', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.specialite, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.specialite) }}
                    </div>
                    <div class="col-lg-6 col-md-12 mb-3">
                        {{ form_label(form.medecinSouhaite, 'Médecin souhaité', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.medecinSouhaite, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.medecinSouhaite) }}
                    </div>
                </div>

                <div class="text-center">
                    <button type="submit" class="btn bouton-perso">Valider</button>
                </div>
            </div>

            <!-- Colonne de droite (2 colonnes) -->
            <div class="col-lg-2">
                <!-- Espace réservé à droite -->
            </div>
        </div>
    </div>

    {{ form_end(form) }}
{% endblock %}
